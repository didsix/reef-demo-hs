---
// src/components/Sections/Home/Facilities.astro - daftar fasilitas homestay di homepage.
import SectionHeader from "@components/Sections/Global/SectionHeader.astro";
import { getLocale } from "@i18n";
import { annotationsDe, styleDuBloc } from "@moteur/annotations";
import Pastilles from "@moteur/Pastilles.astro";

const locale = getLocale(Astro);
const ed = annotationsDe(Astro, "facilities");
const isEn = locale === "en";

const items = isEn
  ? [
      { title: "Bathroom", details: ["Hair dryer"] },
      {
        title: "Bedroom and laundry",
        details: ["Towels", "Bed sheets", "Soap", "Toilet paper", "Hangers"],
      },
      { title: "Living and entertainment", details: ["TV"] },
      { title: "Comfort and connectivity", details: ["WiFi", "Air conditioning"] },
      {
        title: "Kitchen and dining",
        details: ["Kitchen", "Refrigerator", "Cookware", "Oil", "Salt", "Pepper"],
      },
      {
        title: "Home safety",
        details: ["Exterior security cameras", "Car garage", "Fenced perimeter"],
      },
      { title: "Parking and facilities", details: ["Pool"] },
    ]
  : [
      { title: "Kamar mandi", details: ["Hair dryer"] },
      {
        title: "Kamar tidur & laundry",
        details: ["Handuk", "Seprai", "Sabun", "Tisu toilet", "Gantungan baju"],
      },
      { title: "Ruang santai & hiburan", details: ["TV"] },
      { title: "Kenyamanan & konektivitas", details: ["Wifi", "Air conditioning / AC"] },
      {
        title: "Dapur & makan",
        details: ["Dapur", "Kulkas", "Peralatan masak", "Minyak", "Garam", "Merica"],
      },
      {
        title: "Keamanan rumah",
        details: ["Kamera keamanan luar", "Garasi mobil", "Pagar keliling"],
      },
      { title: "Parkir & fasilitas", details: ["Kolam renang"] },
    ];
---

<section
  class="border-border border-t bg-surface"
  aria-labelledby="facilities-title"
  data-slot="facilities"
  {...ed.entree}
  style={styleDuBloc(Astro, "facilities")}
>
  <Pastilles cle="facilities" masquable />

  <div class="container-page py-16 md:py-24">
    <SectionHeader
      as="h2"
      edition={ed}
      headingId="facilities-title"
      eyebrow={isEn ? "Facilities" : "Fasilitas"}
      title={isEn ? "Everything you need for a comfortable stay" : "Semua yang Anda butuhkan untuk menginap nyaman"}
      accentWord={isEn ? "comfortable" : "nyaman"}
      lede={
        isEn
          ? "A quick overview of the essentials and comfort features available during your stay."
          : "Ikhtisar singkat tentang fasilitas penting dan kenyamanan yang tersedia selama menginap."
      }
    />

    <div class="mt-10 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      {
        items.map((item) => (
          <article class="rounded-card border border-border bg-card p-5 shadow-float transition-transform duration-200 hover:-translate-y-0.5 md:p-6">
            <h3 class="font-display text-xl tracking-tight text-foreground md:text-2xl">{item.title}</h3>
            <ul class="mt-4 space-y-2 text-sm leading-relaxed text-muted-foreground md:text-[0.97rem]">
              {item.details.map((detail) => (
                <li class="flex items-start gap-2">
                  <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-primary" aria-hidden="true" />
                  <span>{detail}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
