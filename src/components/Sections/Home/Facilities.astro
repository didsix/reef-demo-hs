---
// src/components/Sections/Home/Facilities.astro - daftar fasilitas homestay di homepage.
import SectionHeader from "@components/Sections/Global/SectionHeader.astro";
import { getLocale } from "@i18n";
import { annotationsDe, styleDuBloc } from "@moteur/annotations";
import Pastilles from "@moteur/Pastilles.astro";

const locale = getLocale(Astro);
const ed = annotationsDe(Astro, "facilities");
const isEn = locale === "en";

const items = isEn
  ? [
      {
        title: "Bathroom",
        details: ["Hair dryer"],
      },
      {
        title: "Bedroom and laundry",
        details: ["Towels", "Bed sheets", "Soap", "Toilet paper", "Hangers"],
      },
      {
        title: "Entertainment",
        details: ["TV"],
      },
      {
        title: "Heating and cooling",
        details: ["Air conditioning"],
      },
      {
        title: "Home safety",
        details: ["Exterior security cameras on property", "Car garage", "Outside the house fence"],
      },
      {
        title: "Internet and office",
        details: ["Wifi"],
      },
      {
        title: "Kitchen and dining",
        details: [
          "Kitchen",
          "Space where guests can cook their own meals",
          "Refrigerator",
          "Cooking basics",
          "Pots and pans",
          "Oil",
          "Salt",
          "Pepper",
        ],
      },
      {
        title: "Parking and facilities",
        details: ["Pool"],
      },
    ]
  : [
      {
        title: "Kamar mandi",
        details: ["Hair dryer"],
      },
      {
        title: "Kamar tidur dan laundry",
        details: ["Handuk", "Seprai", "Sabun", "Tisu toilet", "Gantungan baju"],
      },
      {
        title: "Hiburan",
        details: ["TV"],
      },
      {
        title: "Pemanas dan pendingin",
        details: ["Air conditioning / AC"],
      },
      {
        title: "Keamanan rumah",
        details: ["Kamera keamanan luar", "Garasi mobil", "Pagar luar rumah"],
      },
      {
        title: "Internet dan kantor",
        details: ["Wifi"],
      },
      {
        title: "Dapur dan makan",
        details: [
          "Dapur",
          "Area untuk memasak sendiri",
          "Kulkas",
          "Peralatan dasar",
          "Panci dan wajan",
          "Minyak",
          "Garam",
          "Merica",
        ],
      },
      {
        title: "Parkir dan fasilitas",
        details: ["Kolam renang"],
      },
    ];
---

<section
  class="border-border border-t bg-surface"
  aria-labelledby="facilities-title"
  data-slot="facilities"
  {...ed.entree}
  style={styleDuBloc(Astro, "facilities")}
>
  <Pastilles cle="facilities" masquable />

  <div class="container-page py-16 md:py-24">
    <SectionHeader
      as="h2"
      edition={ed}
      headingId="facilities-title"
      eyebrow={isEn ? "Stay essentials" : "Fasilitas"}
      title={isEn ? "What this place offers" : "Fasilitas yang tersedia"}
      accentWord={isEn ? "offers" : "tersedia"}
      lede={
        isEn
          ? "Everything you need for a relaxed and comfortable stay."
          : "Semua yang dibutuhkan untuk pengalaman menginap yang nyaman dan praktis."
      }
    />

    <div class="mt-10 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      {
        items.map((item) => (
          <article class="rounded-card border border-border bg-card p-5 shadow-float md:p-6">
            <h3 class="font-display text-xl tracking-tight text-foreground md:text-2xl">
              {item.title}
            </h3>

            <ul class="mt-4 space-y-2 text-sm leading-relaxed text-muted-foreground md:text-[0.97rem]">
              {item.details.map((detail) => (
                <li class="flex items-start gap-2">
                  <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-primary" aria-hidden="true" />
                  <span>{detail}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
